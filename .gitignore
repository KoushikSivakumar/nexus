# ============================================================
# NEXUS
# Git ignore rules
# ============================================================

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.crt
secrets/
credentials/
*.secret

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

*.so

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# ------------------------------------------------------------
# FastAPI / application runtime
# ------------------------------------------------------------

*.log
logs/
tmp/
temp/

# Local runtime files
*.pid
*.pidfile

# ------------------------------------------------------------
# Node / frontend
# ------------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

dist/
build/
.vite/

# ------------------------------------------------------------
# IDEs / editors
# ------------------------------------------------------------

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Databases
# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db
*.db-journal

# PostgreSQL local dumps
*.dump
*.sql.gz

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------

docker-compose.override.yml
docker-compose.local.yml

# ------------------------------------------------------------
# ML / AI artifacts
# ------------------------------------------------------------

models/
model_artifacts/

# Keep the NEXUS backend SQLAlchemy models directory tracked
!backend/app/models/
!backend/app/models/**
# ...but keep compiled Python artifacts under it ignored (the negation above re-included them)
backend/app/models/__pycache__/
checkpoints/
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.safetensors

# Local vector/database artifacts
vector_store/
chroma/
.faiss/

# ------------------------------------------------------------
# Generated files
# ------------------------------------------------------------

generated/
artifacts/
outputs/
reports/

# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------

.pytest_cache/
coverage.xml
htmlcov/

# Playwright
playwright-report/
test-results/

# ------------------------------------------------------------
# OS / temporary files
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.swp

# ------------------------------------------------------------
# Local development
# ------------------------------------------------------------

.local/
.local-data/
.cache/

# ------------------------------------------------------------
# Terraform
# ------------------------------------------------------------

.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# Keep example Terraform variables
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------

*.orig
*.rej