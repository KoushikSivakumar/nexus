NEXUS_APP_NAME=NEXUS API
NEXUS_APP_VERSION=0.1.0
NEXUS_ENVIRONMENT=local
NEXUS_DEBUG=false
NEXUS_LOG_LEVEL=INFO
NEXUS_REQUEST_ID_HEADER=X-Request-ID
NEXUS_DATABASE_URL=postgresql+psycopg://nexus:nexus@postgres:5432/nexus
NEXUS_TEST_DATABASE_URL=postgresql+psycopg://nexus:nexus@postgres:5432/nexus_test
NEXUS_REDIS_URL=redis://redis:6379/0
NEXUS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
